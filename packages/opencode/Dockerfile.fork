# Fork-only (tmiland-lab): debian-slim image wrapping the glibc linux-x64
# binary that fork-binary builds & publishes. Not the upstream alpine/musl
# image (musl baseline builds are flaky on stock runners). amd64 for now.
FROM debian:bookworm-slim AS base

# opencode native deps
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
     libgcc-s1 \
     libstdc++6 \
     ripgrep \
     ca-certificates \
  && rm -rf /var/lib/apt/lists/*

FROM base
COPY packages/opencode/dist/opencode-linux-x64/bin/opencode /usr/local/bin/opencode
RUN opencode --version
ENTRYPOINT ["opencode"]